	$(MAKE) $(MAKESILENT) -f CMakeFiles/server_lib.dir/build.make CMakeFiles/server_lib.dir/src/server/user_registry.cpp.i
.PHONY : src/server/user_registry.cpp.i

src/server/user_registry.s: src/server/user_registry.cpp.s
.PHONY : src/server/user_registry.s

# target to generate assembly for a file
src/server/user_registry.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/server_lib.dir/build.make CMakeFiles/server_lib.dir/src/server/user_registry.cpp.s
.PHONY : src/server/user_registry.cpp.s

